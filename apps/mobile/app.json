{
  "expo": {
    "name": "Site Diary",
    "slug": "site-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.sitediary.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C2410C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.sitediary.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Site Diary",
      "shortName": "Site Diary",
      "themeColor": "#C2410C",
      "backgroundColor": "#FAF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#C2410C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2"
        }
      ]
    ],
    "scheme": "sitediary",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f333777-ca21-43ad-b1ef-8caadba2b246"
      }
    },
    "owner": "pratik-senjaliya",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6f333777-ca21-43ad-b1ef-8caadba2b246"
    }
  }
}
