DATABASE_URL=postgresql://site:site@localhost:5432/site_diary
# Same as DATABASE_URL unless DATABASE_URL goes through a pooler (Supabase port 6543)
DIRECT_URL=postgresql://site:site@localhost:5432/site_diary
PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:8081
PUBLIC_WEB_URL=http://localhost:3000
# dev prints the code in this log; OTP_DEV_CODE also always works (never in production)
OTP_PROVIDER=dev
OTP_DEV_CODE=123456
# STORAGE_DRIVER=local keeps photos in ./uploads; s3 = Cloudflare R2 / any S3 bucket
STORAGE_DRIVER=local
# JWT_SECRET=change-me (required in production)
