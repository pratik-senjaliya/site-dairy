# The API service, as the web app's server code sees it. Read at RUNTIME, per request, by
# src/app/api/v1/[...path]/route.ts. It is not needed to build, and one build runs against any value.
# Local: the API from `npm run dev:api`. Render or Railway: the API service URL
# Copy to .env.local; there is deliberately no default in code.
API_URL="http://localhost:4000"
